          "type": "pause",
          "args": "1000"
        },
        {
          "type": "move",
          "args": "{name} 1 0 1"
        },
        {
          "type": "speak",
          "args": "{name} \"$0Tell me... \""
        },
        {
          "type": "question",
          "args": "fork0 \"When you carry a burden that cannot be erased, nor fixed... how do you live with it? #(Be honest) You carry it forward, but don't let it define you.#(Offer comfort) You focus on the present. What you can do in the here and now.\""
        },
        {
          "type": "fork",
          "args": "carry_it_forward"
        },
        {
          "type": "move",
          "args": "{name} 0 0 0"
        },
        {
          "type": "speak",
          "args": "{name} \"$1The present... You make it sound so simple. But... perhaps it is possible.\""
        },
        {
          "type": "emote",
          "args": "{name} 32"
        },
